      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#e15759'>Category wise YTD vs PYTD Sales</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Dataco (Abhijit database)_Dataco' name='federated.0ekcpxe1btfdft1by4rou0xrbcth' />
          </datasources>
          <datasource-dependencies datasource='federated.0ekcpxe1btfdft1by4rou0xrbcth'>
            <column caption='YTD Sales' datatype='real' name='[Calculation_0084841123151892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date])={MAX(YEAR([Order Date]))} THEN [Sales] END' />
            </column>
            <column caption='% Difference' datatype='real' name='[Calculation_0084841126862870]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_0084841123151892])-SUM([YTD Sales (copy)_0084841126678549]))/SUM([YTD Sales (copy)_0084841126678549])' />
            </column>
            <column caption='Salaes Margin' datatype='string' name='[Calculation_0084841127645207]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Calculation_0084841123151892])-SUM([YTD Sales (copy)_0084841126678549])&lt;0 THEN &apos;Less than PY&apos;&#10;ELSEIF SUM([Calculation_0084841123151892])-SUM([YTD Sales (copy)_0084841126678549])&gt;0 THEN&apos;Greater than PY&apos;&#10;ELSEIF ISNULL(SUM([YTD Sales (copy)_0084841126678549])) THEN &apos;No Sales in PY&apos;&#10;END' />
            </column>
            <column caption='Positive % DIff' datatype='string' name='[Calculation_0084841129046040]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0084841126862870]&gt;0 THEN &apos;▲&apos; END' />
            </column>
            <column caption='No Sales' datatype='string' name='[Calculation_0084841129689115]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0084841127645207]=&apos;No sales in PY&apos; THEN &apos;No sales in PY&apos; END' />
            </column>
            <column datatype='string' name='[Category Name]' role='dimension' type='nominal' />
            <column datatype='string' name='[Customer Segment]' role='dimension' type='nominal' />
            <column datatype='string' name='[Market]' role='dimension' type='nominal' />
