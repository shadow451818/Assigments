      <column caption='YTD Sales LOD' datatype='real' name='[Calculation_0084841102016512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED:SUM(IF YEAR([Order Date])={MAX(YEAR([Order Date]))} THEN [Sales] END )}' />
      </column>
      <column caption='YOY Sales%' datatype='real' name='[Calculation_0084841103364098]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_0084841102016512]-[YTD Sales LOD (copy)_0084841103204353])/[YTD Sales LOD (copy)_0084841103204353]' />
      </column>
      <column caption='YOY Sales Margin' datatype='string' name='[Calculation_0084841105596419]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0084841103364098]&gt;0 THEN &apos;▲&apos; ELSEIF [Calculation_0084841103364098]&lt;0 THEN &apos;▼&apos; END' />
