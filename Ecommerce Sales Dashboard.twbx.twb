            <run fontcolor='#e15759'><![CDATA[         <[federated.0ekcpxe1btfdft1by4rou0xrbcth].[sum:YTD Sales LOD (copy)_0084841117007881:qk]>]]></run>
            <run>Æ&#10;                </run>
            <run fontcolor='#e15759'><![CDATA[            <[federated.0ekcpxe1btfdft1by4rou0xrbcth].[none:YOY Sales Margin (copy)_0084841118015499:nk]>]]></run>
            <run>Æ </run>
            <run fontcolor='#e15759'><![CDATA[<[federated.0ekcpxe1btfdft1by4rou0xrbcth].[sum:YOY Sales% (copy)_0084841118130188:qk]> vs PY]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Dataco (Abhijit database)_Dataco' name='federated.0ekcpxe1btfdft1by4rou0xrbcth' />
          </datasources>
          <datasource-dependencies datasource='federated.0ekcpxe1btfdft1by4rou0xrbcth'>
            <column datatype='string' name='[Customer Segment]' role='dimension' type='nominal' />
            <column datatype='string' name='[Market]' role='dimension' type='nominal' />
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Order Quantity]' role='measure' type='quantitative' />
            <column caption='PYTD Quantity LOD' datatype='integer' name='[PYTD SalesLOD (copy)_0084841117376522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED:SUM(IF YEAR([Order Date])={MAX(YEAR([Order Date]))-1} THEN [Order Quantity] END )}' />
            </column>
            <column datatype='real' name='[Profit Per Order]' role='measure' type='quantitative' />
            <column caption='YOY Quantity  Margin ' datatype='string' name='[YOY Sales Margin (copy)_0084841118015499]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [YOY Sales% (copy)_0084841118130188]&gt;0 THEN &apos;▲&apos; ELSEIF [YOY Sales% (copy)_0084841118130188]&lt;0 THEN &apos;▼&apos; END' />
            </column>
            <column caption='YOY Quantity %' datatype='real' name='[YOY Sales% (copy)_0084841118130188]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([YTD Sales LOD (copy)_0084841117007881]-[PYTD SalesLOD (copy)_0084841117376522])/[PYTD SalesLOD (copy)_0084841117376522]' />
            </column>
            <column caption='YTD Quantity LOD' datatype='integer' name='[YTD Sales LOD (copy)_0084841117007881]' role='measure' type='quantitative'>
